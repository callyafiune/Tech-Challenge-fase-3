{
  "actionlint_versao": "v1.7.12",
  "actionlint_codigo_saida": 0,
  "yaml_valido": true,
  "nome_produtor_preservado": "imagem-validada-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}",
  "download_por_id_do_produtor": "${{ needs.qualidade.outputs.imagem_artefato_id }}",
  "diretorio_download": "imagem",
  "flatten_download": true,
  "validacao_id_bash": [
    {
      "valor": "123456789",
