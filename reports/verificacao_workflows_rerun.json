    },
    {
      "valor": "",
      "codigo_saida": 1
    },
    {
      "valor": "1,2",
      "codigo_saida": 1
    },
    {
      "valor": "abc",
      "codigo_saida": 1
    },
    {
      "valor": "123\n456",
      "codigo_saida": 1
    }
  ],
  "fontes": [
    "https://docs.github.com/en/actions/reference/workflows-and-actions/contexts#github-context",
    "https://docs.github.com/en/actions/how-tos/reuse-automations/reuse-workflows#using-outputs-from-a-reusable-workflow",
    "https://raw.githubusercontent.com/actions/upload-artifact/v4/README.md",
    "https://raw.githubusercontent.com/actions/download-artifact/v4/README.md"
  ]
}
