{
  "uid": "medical-classifier",
  "title": "Classificação médica — operação da API",
  "description": "Métricas operacionais do classificador de condições médicas. Resumos em inglês; não mede urgência clínica nem qualidade preditiva em produção.",
  "tags": [
    "Tech Challenge",
    "NLP",
    "Observabilidade"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requisições de classificação",
      "description": "Total de POST /predict desde o início do processo. Inclui entradas rejeitadas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Coleta de métricas",
      "description": "1 indica que o Prometheus alcança /metrics; isto é diferente da prontidão do modelo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"medical-api\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "max": 1,
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Modelo pronto",
      "description": "1 exige modelo pronto e coleta ativa; falha na coleta ou ausência de série indica indisponibilidade (0).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(model_ready{job=\"medical-api\"} * on(job, instance) up{job=\"medical-api\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "max": 1,
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chamadas de classificação por segundo",
      "description": "Taxa calculada em uma janela com pelo menos quatro coletas; métricas só de POST /predict.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Chamadas/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latência HTTP p50 e p95",
      "description": "Quantis estimados do histograma de POST /predict, incluindo validação e serialização. Sem tráfego suficiente, o painel permanece sem amostras; não é o benchmark isolado do modelo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"medical-api\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"medical-api\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Proporção de erros de classificação",
      "description": "Percentual das chamadas de POST /predict rejeitadas (4xx) e falhas de serviço (5xx). Sem chamadas, mostra 0%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-medical"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\",status=~\"4..\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\"}[$__rate_interval])) or vector(0)), 1e-9)",
          "legendFormat": "Entradas rejeitadas (4xx)"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"medical-api\",route=\"/predict\",method=\"POST\"}[$__rate_interval])) or vector(0)), 1e-9)",
          "legendFormat": "Falhas do serviço (5xx)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
